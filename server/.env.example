# Copy to server/.env (never commit). Without ANTHROPIC_API_KEY the server runs in MOCK mode.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: ElevenLabs model overrides
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1
PORT=8787
# MOCK=1 forces canned Claude responses even when ANTHROPIC_API_KEY is set
MOCK=0

# Long-term semantic memory (Qdrant). Works with no settings: on first start the server downloads the Qdrant
# binary for your OS (no Docker) and a small local embedding model into server/.vector, then runs both itself.
# MEMORY_BACKEND=json        # keyword recall only, start nothing
# QDRANT_PORT=6333           # port of the local Qdrant (gRPC uses the next one)
# QDRANT_URL=                # use an existing Qdrant instead (Qdrant Cloud, another machine)
# QDRANT_API_KEY=
